# === Основные настройки Django ===
# Режим отладки (True для разработки, False для production)
DEBUG=

# Секретный ключ Django (сгенерируйте уникальный, не используйте в production публичный)
SECRET_KEY=

# === Настройки базы данных PostgreSQL ===
# Имя базы данных
POSTGRES_DB=
# Пользователь базы данных
POSTGRES_USER=
# Пароль пользователя базы данных
POSTGRES_PASSWORD=
# Хост базы данных (локально: localhost, в Docker: имя сервиса db)
POSTGRES_HOST=
# Порт базы данных (обычно 5432)
POSTGRES_PORT=